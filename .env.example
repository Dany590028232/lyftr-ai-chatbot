# Comma-separated Gemini key pool (at least 2). Ids are key_1, key_2, ... in order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# LiteLLM model name
GEMINI_MODEL=gemini/gemini-3.6-flash
# Optional comma-separated models tried (with every key) after the primary model fails on all keys
FALLBACK_MODELS=gemini/gemini-3.5-flash-lite
# Per-call provider timeout in seconds
LLM_TIMEOUT_SECONDS=25
# Max completion tokens (thinking models use part of this budget)
MAX_OUTPUT_TOKENS=2048
# SQLite location (docker-compose overrides this to the /data volume)
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test hook
ENABLE_FAILURE_SIMULATION=true
# Frontend: backend base URL baked into the React build
VITE_API_URL=http://localhost:8000
